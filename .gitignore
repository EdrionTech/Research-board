/.vscode
/.history
# your data (the local server keeps it here)
/data
/data-public
# what belongs to this computer only: the server's settings (serve.json), serve.log, downloaded tools (cloudflared)
/local

# the original design-system packs (reference only; the app uses its copies in src/style/themes)
/design_document

# finished builds (run build ...) and what the app projects make while building
/apps/builds
/apps/desktop/src-tauri/target
/apps/desktop/src-tauri/gen
/apps/phone/node_modules
# the phone app's release key and its passwords (run build phone-release): back it up, never commit it
/apps/phone/keystore

# the tests' tools and screenshots
/tests/node_modules
/tests/shots

.fake

.github
